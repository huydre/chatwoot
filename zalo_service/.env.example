# Zalo service configuration
NODE_ENV=development
LOG_LEVEL=info

# HTTP server
ZALO_SERVICE_PORT=4567
ZALO_SERVICE_HOST=127.0.0.1

# Shared secret between Rails and Node (generate: openssl rand -hex 32)
ZALO_SERVICE_INTERNAL_TOKEN=

# Redis (shared with Chatwoot)
REDIS_URL=redis://localhost:6379

# Rails internal API base URL (for session persistence callbacks)
CHATWOOT_INTERNAL_URL=http://127.0.0.1:3000

# Limits
ZALO_MAX_SESSIONS_PER_PROCESS=50
